# Copy this file to .env and fill in real values before first run.
# .env is gitignored — never commit it.

# Random strong key used to derive the Fernet encryption key for API keys at rest.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
RECON_MASTER_KEY=change-me-before-production

# Salt for PBKDF2 key derivation.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(16))"
ENCRYPTION_SALT=change-me-salt-before-production

# Allowed origins for CORS and WebSocket validation (JSON list format).
# Must match the URL you access the app from (browser origin).
# Example: ALLOWED_ORIGINS=["http://192.168.1.10:8080"]
ALLOWED_ORIGINS=["http://localhost:8080"]

# Trusted hostnames for Host header validation — prevents Host header injection.
# IMPORTANT: Always keep localhost + localhost:8000 — Docker healthcheck uses them.
# nginx strips the port via $host, so add just the bare IP for remote access.
# Example: TRUSTED_HOSTS=["localhost","localhost:8000","127.0.0.1","127.0.0.1:8000","192.168.1.10","192.168.1.10:8080"]
TRUSTED_HOSTS=["localhost","localhost:8000","127.0.0.1","127.0.0.1:8000"]
